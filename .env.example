# ============================================
# DeepRCA-Agent Environment Configuration
# ============================================
# Copy this file to .env and fill in the values.

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# 外部可访问地址，用于生成满意度反馈 URL（Docker 外访问时用 localhost）
APP_EXTERNAL_HOST=localhost
LOG_LEVEL=INFO

# --- LLM ---
# OpenAI-compatible API endpoint
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=30

# --- Redis (standard Redis, NOT Squirrel) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Kafka (standard Kafka, NOT Mafka) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_FEEDBACK_TOPIC=deeprca-feedback

# --- Analysis ---
ANALYSIS_TIMEOUT=60
TOOL_CALL_TIMEOUT=10
MAX_CONCURRENT_TASKS=10

# --- Mock Environment ---
MOCK_ENV_ENABLED=true
MOCK_K8S_API=http://localhost:8001
# 以下三个在 mock_env_enabled=True 时不被使用，统一指向 8001 避免端口混淆
MOCK_MONITOR_API=http://localhost:8001
MOCK_LOG_API=http://localhost:8001
MOCK_CHANGE_API=http://localhost:8001

# Agent 服务访问地址（Mock 容器内调用时使用；容器环境建议设为 http://deeprca-agent:8000）
AGENT_URL=http://localhost:8000

# --- OpsPilot recoverable runtime (Stage 2) ---
OPSPILOT_DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot
OPSPILOT_REDIS_URL=redis://localhost:6379/0
OPSPILOT_QUEUE_NAME=opspilot:runs
OPSPILOT_GRAPH_VERSION=opspilot-runtime-v1
OPSPILOT_CONFIG_VERSION=default-v1
OPSPILOT_CHECKPOINT_SCHEMA_VERSION=1.0
OPSPILOT_RECOVERY_STALE_SECONDS=30
OPSPILOT_RECOVERY_SCAN_SECONDS=5
OPSPILOT_RETRY_BACKOFF_SECONDS=0.05
OPSPILOT_QUEUE_REPAIR_SECONDS=30
OPSPILOT_TOOL_TIMEOUT_SECONDS=0.2
OPSPILOT_TOOL_MAX_ATTEMPTS=2
