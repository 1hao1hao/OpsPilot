# OpsPilot: copy to .env and fill in local values.
# Independent Mock service
AGENT_URL=http://localhost:8000
ANALYSIS_TIMEOUT=60

# RCA investigation (LLM optional)
OPSPILOT_LLM_ENABLED=false
DEEPSEEK_API_KEY=
OPSPILOT_LLM_MODEL=deepseek-v4-flash
OPSPILOT_LLM_BASE_URL=https://api.deepseek.com
OPSPILOT_LLM_TIMEOUT_SECONDS=30
OPSPILOT_INVESTIGATION_MAX_ROUNDS=4
OPSPILOT_INVESTIGATION_MAX_TOOL_CALLS=8
OPSPILOT_INVESTIGATION_MAX_EXPERT_CALLS=2
OPSPILOT_MOCK_BASE_URL=http://localhost:8001

# Recoverable runtime
OPSPILOT_DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot
OPSPILOT_REDIS_URL=redis://localhost:6379/0
OPSPILOT_QUEUE_NAME=opspilot:runs
OPSPILOT_GRAPH_VERSION=opspilot-runtime-v6-compact-report
OPSPILOT_CONFIG_VERSION=default-v1
OPSPILOT_CHECKPOINT_SCHEMA_VERSION=3.0
OPSPILOT_RECOVERY_STALE_SECONDS=30
OPSPILOT_RECOVERY_SCAN_SECONDS=5
OPSPILOT_RETRY_BACKOFF_SECONDS=0.05
OPSPILOT_QUEUE_REPAIR_SECONDS=30
OPSPILOT_TOOL_TIMEOUT_SECONDS=0.2
OPSPILOT_TOOL_MAX_ATTEMPTS=2
