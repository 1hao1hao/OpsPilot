    "changes.query",
    "db.connections",
    "db.replication",
    "db.slowlog",
    "kafka.lag",
    "logs.query",
    "metrics.query",
    "redis.hotkeys",
    "redis.memory",
    "rpc.metrics",
    "topology.query",
    "traces.query"
  ],
  "llm_role": "planner only; identical deterministic ranking/summary in all modes"
