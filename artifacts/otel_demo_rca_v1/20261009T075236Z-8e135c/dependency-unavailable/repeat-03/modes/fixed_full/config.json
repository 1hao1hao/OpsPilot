{
  "mode": "fixed_full",
  "settings": {
    "database_url": "postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot",
    "redis_url": "redis://localhost:6379/0",
    "queue_name": "opspilot:runs",
    "graph_version": "opspilot-runtime-v6-compact-report",
    "config_version": "adaptive-v2",
    "checkpoint_schema_version": "3.0",
    "recovery_stale_seconds": 30.0,
    "queue_poll_seconds": 1.0,
    "retry_backoff_seconds": 0.05,
    "recovery_scan_seconds": 5.0,
    "queue_repair_seconds": 30.0,
    "tool_timeout_seconds": 30.0,
    "tool_max_attempts": 2,
    "investigation_max_rounds": 4,
    "investigation_max_tool_calls": 8,
    "investigation_max_expert_calls": 2,
    "evidence_gate_confidence": 0.8,
    "evidence_gate_margin": 0.15,
    "evidence_gate_min_sources": 2,
    "mock_base_url": "http://localhost:8001",
    "llm_enabled": false,
    "llm_model": "deepseek-v4-flash",
    "llm_base_url": "https://api.deepseek.com",
    "llm_timeout_seconds": 30.0,
    "observation_backend": "otel_demo",
    "prometheus_url": "http://127.0.0.1:19090",
    "jaeger_url": "http://127.0.0.1:16686/jaeger/ui",
    "opensearch_url": "http://127.0.0.1:19200",
    "opensearch_index": "otel-logs-*",
